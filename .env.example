OPENAI_API_KEY=
OPENAI_BEARER_TOKEN=
OPENAI_OAUTH_ACCESS_TOKEN=
SWARM_OPENAI_AUTH_MODE=auto
OPENAI_SWARM_MODEL=gpt-5.2
OPENAI_RESEARCH_MODEL=
SWARM_CODEX_MODEL=codex-5.3
SWARM_CODEX_AUTH_FILE=
SWARM_MODEL_ROUTING_FILE=config/model-routing.json
SWARM_CODEX_SUPPORTS_MODEL_FLAG=0
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_OIDC_TOKEN=

# Optional: use OpenAI, Gemini, or Vertex Gemini for research augmentation.
# Set SWARM_RESEARCH_PROVIDER=openai, gemini, or vertex to enable.
SWARM_RESEARCH_PROVIDER=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_API_KEY=
GEMINI_SWARM_MODEL=gemini-3.1-pro-preview
GEMINI_SWARM_FAST_MODEL=gemini-3.1-flash-preview

# Optional: Google auth for Gemini (instead of API key).
GOOGLE_USE_ADC=0
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_USE_VERTEXAI=0
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_OPENAI_BASE_URL=
SWARM_MODEL_OPTIMIZER_LIVE_PROBE=0

# Optional runtime overrides
SWARM_CODEX_BIN=codex
SWARM_CODEX_ISOLATE_HOME=1
SWARM_CODEX_HOME=.codex-swarm
SWARM_CODEX_SOURCE_HOME=
SWARM_FORCE_DEMO=0

# Optional: external web research adapter.
SWARM_WEB_SEARCH=0
SWARM_WEB_SEARCH_PROVIDER=bing
SWARM_WEB_SEARCH_MAX_RESULTS=6
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search

# Batch multi-agent pipeline
OPENAI_BATCH_MODEL=gpt-4o-mini
BATCH_PROJECT=run1
SHARD_MAX_LINES=10000
UPLOAD_CONCURRENCY=3
POLL_INTERVAL_MS=5000
BATCH_RETRY_MAX_ATTEMPTS=2
BATCH_RETRY_ON_SCHEMA_FAIL=1
BATCH_VALIDATE_MERGE=1
BATCH_RETRY_SHARD_MAX_LINES=10000
SWARM_BATCH_MERGED_FILE=batch/out/merged_output.jsonl

# Microsoft Agent Framework + Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=

# ── Runtime version selector ────────────────────────────────────
# "custom" = built-in swarm engine (lib/swarm/engine.ts)
# "adk"    = Google ADK / Vertex AI agent runtime (adk_agents/)
SWARM_RUNTIME=custom

# Google ADK (needed when SWARM_RUNTIME=adk)
GOOGLE_ADK_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=  # or use ADC (GOOGLE_USE_ADC=1) above

# ── Anthropic provider ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

# ── Ollama (local models) ──────────────────────────────────────
OLLAMA_MODEL=
OLLAMA_HOST=
OLLAMA_BASE_URL=

# ── Gemini OpenAI-compatible endpoint ──────────────────────────
GEMINI_OPENAI_BASE_URL=

# ── Provider tuning ─────────────────────────────────────────────
SWARM_PROVIDER_MAX_OUTPUT_TOKENS=

# ── Runtime tuning ──────────────────────────────────────────────
SWARM_STALL_TIMEOUT_MS=120000
SWARM_HEARTBEAT_INTERVAL_MS=10000
SWARM_STALE_THRESHOLD_MS=3600000

# ── Tool configuration ─────────────────────────────────────────
SWARM_ENABLE_TOOLS=1
SWARM_TOOL_MAX_STEPS=10
SWARM_TOOL_MAX_FILE_SIZE=100000
SWARM_TOOL_SHELL_TIMEOUT_MS=30000

# ── Qdrant vector search ───────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=workspace
