{
	"name": "codex-orch",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"omni": "python scripts/omni_cli.py",
		"bootstrap": "node scripts/dev/bootstrap.mjs",
		"doctor": "node scripts/dev/doctor.mjs",
		"test": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { readdirSync } from 'node:fs'; import { join } from 'node:path'; const walk=(d)=>readdirSync(d,{withFileTypes:true}).flatMap((e)=>{const p=join(d,e.name); return e.isDirectory()?walk(p):p;}); const files=walk('tests').filter((f)=>f.endsWith('.test.ts')).sort(); const r=spawnSync('tsx',['--test',...files],{stdio:'inherit'}); process.exit(r.status ?? 1);\"",
		"dev": "next dev --port 3017",
		"dev:dashboard": "next dev --port 3017",
		"dev:gui": "next dev --port 3017",
		"dev:foundry": "node scripts/dev/run-agent.mjs",
		"dev:agent": "npm run dev:foundry",
		"dev:cli": "tsx scripts/swarm-cli.ts run --mode local --max-rounds 3",
		"dev:all": "concurrently -k -n GUI,FOUNDRY \"npm run dev:gui\" \"npm run dev:foundry\"",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "npm run typecheck",
		"build:python": "node scripts/dev/compile-python.mjs",
		"build:web": "next build",
		"build:all": "npm run typecheck && npm run build:web && npm run build:python",
		"build": "npm run build:all",
		"start": "next start --port 3017",
		"start:web": "next start --port 3017",
		"start:worker": "tsx scripts/swarm-worker.ts",
		"swarm:setup": "tsx scripts/swarm-cli.ts setup",
		"swarm:run": "tsx scripts/swarm-cli.ts run",
		"swarm:status": "tsx scripts/swarm-cli.ts status",
		"swarm:pause": "tsx scripts/swarm-cli.ts pause",
		"swarm:resume": "tsx scripts/swarm-cli.ts resume",
		"swarm:rewind": "tsx scripts/swarm-cli.ts rewind",
		"swarm:worker": "tsx scripts/swarm-worker.ts",
		"swarm:deploy": "tsx scripts/swarm-cli.ts deploy",
		"swarm:deploy:azure": "tsx scripts/swarm-cli.ts deploy --target azure",
		"swarm:deploy:vercel": "tsx scripts/swarm-cli.ts deploy --target vercel",
		"models:discover": "tsx scripts/swarm-models.ts discover",
		"models:optimize": "tsx scripts/swarm-models.ts optimize",
		"models:evaluate": "tsx scripts/swarm-models.ts evaluate",
		"models:show": "tsx scripts/swarm-models.ts show",
		"batch:gen": "node scripts/batch/gen_shards.mjs",
		"batch:run": "node scripts/batch/run_batches.mjs",
		"memory:refresh": "tsx scripts/memory-refresh.ts refresh",
		"memory:status": "tsx scripts/memory-refresh.ts status",
		"memory:merge": "tsx scripts/memory-refresh.ts merge",
		"memory:help": "tsx scripts/memory-refresh.ts help"
	},
	"dependencies": {
		"@ai-sdk/mcp": "^2.0.2",
		"@ai-sdk/openai": "^4.0.1",
		"@azure/identity": "^4.13.1",
		"@azure/storage-blob": "^12.31.0",
		"@composio/core": "^0.13.1",
		"@genkit-ai/mcp": "^1.31.0",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"ai": "^7.0.3",
		"ajv": "^8.17.1",
		"composio": "^1.0.0",
		"dotenv": "^16.4.5",
		"hermes": "^0.4.4",
		"lucide-react": "^0.577.0",
		"next": "^16.1.6",
		"nextjs": "^0.0.3",
		"openai": "^4.68.1",
		"pg": "^8.20.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-markdown": "^10.1.0",
		"redis": "^5.11.0",
		"yaml": "^2.8.2",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
		"@opentelemetry/resources": "^2.1.0",
		"@opentelemetry/sdk-trace-base": "^2.1.0",
		"@opentelemetry/sdk-trace-node": "^2.1.0",
		"@opentelemetry/semantic-conventions": "^1.37.0",
		"@playwright/test": "^1.58.2",
		"@types/node": "^20.17.57",
		"@types/pg": "^8.20.0",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^18.3.1",
		"concurrently": "^9.0.1",
		"markdownlint": "^0.40.0",
		"tsx": "^4.21.0",
		"typescript": "^5.6.3"
	}
}
